<Window x:Class="OmenLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmenLite"
        Title="OmenLite" Width="1020" Height="860" MinWidth="860" MinHeight="620"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Body}" FontSize="13"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Geometry x:Key="FanGlyph">M12,12 C10,8 10,3 13,2 C15,5 14,9 12,12 Z M12,12 C16,10 21,10 22,13 C19,15 15,14 12,12 Z M12,12 C14,16 14,21 11,22 C9,19 10,15 12,12 Z M12,12 C8,14 3,14 2,11 C5,9 9,10 12,12 Z</Geometry>
  </Window.Resources>
  <Grid>
    <!-- One soft bloom, static -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.7" RadiusY="0.6">
          <GradientStop Color="#33E2231A" Offset="0"/>
          <GradientStop Color="#00E2231A" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <DockPanel Margin="16,12,16,8">
      <!-- Header: wordmark + live mode pill -->
      <Grid DockPanel.Dock="Top" Margin="8,4,8,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="OMEN" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="Lite" FontFamily="{StaticResource Display}" FontSize="26" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="BoostPill" Background="{StaticResource Accent}" CornerRadius="12" Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed">
            <TextBlock Text="Game boost" Foreground="White" FontWeight="SemiBold"/>
          </Border>
          <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="12" Padding="12,5">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="ModePill" Text="Balanced"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Margin="8,4" Padding="12,8" CornerRadius="9" Background="{StaticResource Paper2}">
        <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Ready"/>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <!-- Telemetry -->
          <Border x:Name="C0" Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Live"/>
              <UniformGrid Columns="2">
                <StackPanel>
                  <local:Gauge x:Name="CpuGauge" Label="CPU"/>
                  <TextBlock x:Name="CpuSub" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel>
                  <local:Gauge x:Name="GpuGauge" Label="GPU"/>
                  <TextBlock x:Name="GpuSub" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
              </UniformGrid>
              <UniformGrid Columns="2" Margin="0,16,0,0">
                <Border Background="{StaticResource Paper3}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal">
                    <Path x:Name="CpuFanIcon" Data="{StaticResource FanGlyph}" Fill="{StaticResource Muted}" Width="24" Height="24" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform><RotateTransform x:Name="CpuFanRot"/></Path.RenderTransform>
                    </Path>
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock x:Name="CpuFanText" FontFamily="{StaticResource Display}" FontSize="18" Text="—"/>
                      <TextBlock Style="{StaticResource Sub}" Text="CPU fan · RPM"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Paper3}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path x:Name="GpuFanIcon" Data="{StaticResource FanGlyph}" Fill="{StaticResource Muted}" Width="24" Height="24" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform><RotateTransform x:Name="GpuFanRot"/></Path.RenderTransform>
                    </Path>
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock x:Name="GpuFanText" FontFamily="{StaticResource Display}" FontSize="18" Text="—"/>
                      <TextBlock Style="{StaticResource Sub}" Text="GPU fan · RPM"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- Performance: segmented control with sliding indicator -->
          <Border x:Name="C1" Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Performance mode"/>
              <Border Background="{StaticResource Paper3}" CornerRadius="10" Padding="4">
                <Grid x:Name="PerfSeg" SizeChanged="PerfSeg_SizeChanged">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border x:Name="PerfIndicator" Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="7">
                    <Border.RenderTransform><TranslateTransform x:Name="PerfShift"/></Border.RenderTransform>
                  </Border>
                  <Button Style="{StaticResource Seg}" Grid.Column="0" Content="Quiet" Tag="Quiet" Click="Perf_Click"/>
                  <Button Style="{StaticResource Seg}" Grid.Column="1" Content="Cool" Tag="Cool" Click="Perf_Click"/>
                  <Button Style="{StaticResource Seg}" Grid.Column="2" Content="Balanced" Tag="Balanced" Click="Perf_Click"/>
                  <Button Style="{StaticResource Seg}" Grid.Column="3" Content="Performance" Tag="Performance" Click="Perf_Click"/>
                </Grid>
              </Border>
              <TextBlock x:Name="PerfText" Style="{StaticResource Sub}" Margin="2,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Fans -->
          <Border x:Name="C2" Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Fans"/>
              <CheckBox x:Name="MaxFanBox" Content="Max fan" Click="MaxFan_Click"/>
              <CheckBox x:Name="ManualFanBox" Content="Manual speed" Checked="ManualFan_Checked" Unchecked="ManualFan_Unchecked"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <!-- Minimum 2000: BIOS level 0 is a real 0 RPM target, not auto -->
                <Slider x:Name="FanSlider" Minimum="2000" Maximum="5500" TickFrequency="100" IsSnapToTickEnabled="True"
                        Value="3000" IsEnabled="False" ValueChanged="FanSlider_Changed" VerticalAlignment="Center"/>
                <TextBlock x:Name="FanSliderText" Grid.Column="1" Margin="14,0,0,0" FontFamily="{StaticResource Display}" FontSize="18" Text="3000 RPM" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Lighting -->
          <Border x:Name="C3" Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Keyboard lighting"/>
              <Grid x:Name="ZonePanel">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <!-- Tag = BIOS buffer index (0 Right, 1 Middle, 2 Left, 3 WASD; verified on this keyboard); columns follow physical left-to-right order -->
                <Button x:Name="Z2" Grid.Column="0" Height="44" Tag="2" Click="Zone_Click"/>
                <Button x:Name="Z3" Grid.Column="1" Height="44" Tag="3" Click="Zone_Click"/>
                <Button x:Name="Z1" Grid.Column="2" Height="44" Tag="1" Click="Zone_Click"/>
                <Button x:Name="Z0" Grid.Column="3" Height="44" Tag="0" Click="Zone_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ZoneLabel}" Text="Left"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ZoneLabel}" Text="WASD"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ZoneLabel}" Text="Middle"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ZoneLabel}" Text="Right"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Sub}" Text="Presets" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <Button Width="30" Height="30" Padding="0" Tag="#E2231A" Background="#E2231A" ToolTip="Red, all zones" Click="Preset_Click"/>
                <Button Width="30" Height="30" Padding="0" Tag="#00C8FF" Background="#00C8FF" ToolTip="Cyan, all zones" Click="Preset_Click"/>
                <Button Width="30" Height="30" Padding="0" Tag="#8A3CFF" Background="#8A3CFF" ToolTip="Violet, all zones" Click="Preset_Click"/>
                <Button Width="30" Height="30" Padding="0" Tag="#FFB000" Background="#FFB000" ToolTip="Amber, all zones" Click="Preset_Click"/>
                <Button Width="30" Height="30" Padding="0" Tag="#FFFFFF" Background="#FFFFFF" ToolTip="White, all zones" Click="Preset_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="Custom colour for all" Click="AllSame_Click"/>
                <CheckBox x:Name="BacklightBox" Content="Backlight" Click="Backlight_Click" VerticalAlignment="Center" Margin="8,0,0,8"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Graphics -->
          <Border x:Name="C4" Style="{StaticResource Card}" Grid.Row="2" Grid.Column="0">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Graphics mode"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="GpuCombo" Width="160" Height="34" Margin="0,0,8,8" VerticalContentAlignment="Center"/>
                <Button Content="Apply" Click="GpuApply_Click"/>
              </StackPanel>
              <TextBlock x:Name="GpuModeText" Style="{StaticResource Sub}"/>
              <TextBlock Style="{StaticResource Sub}" Text="Takes effect after a reboot." Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Booster -->
          <Border x:Name="C5" Style="{StaticResource Card}" Grid.Row="2" Grid.Column="1">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Booster"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BoostBtn" Content="Start game boost" Click="Boost_Click"/>
                <Button Content="Clean cache" Click="Clean_Click"/>
              </StackPanel>
              <CheckBox x:Name="AutostartBox" Content="Start with Windows (tray)" Click="Autostart_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
